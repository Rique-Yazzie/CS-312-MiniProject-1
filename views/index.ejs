<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Blog Application</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <h1>My Blog</h1>

    <h2>Create a New Blog Post</h2>

    <!-- When user submits the form, send information to /posts -->
    <form action="/posts" method="POST">

        <label for="creator">Your Name:</label>
        <input type="text" id="creator" name="creator" required>

        <br><br>

        <label for="title">Blog Title:</label>
        <input type="text" id="title" name="title" required>

        <br><br>

        <label for="blog">Blog:</label>
        <textarea id="blog" name="blog" required></textarea>

        <br><br>

        <button type="submit">Create Post</button>

    </form>

    <h2>Blog Posts</h2>

    <!-- for each post in the posts array, render it -->
    <% posts.forEach(post => { %>

        <article>

            <h3><%= post.title %></h3>

            <p>By <%= post.creator %></p>

            <p><%= post.date %></p>

            <p><%= post.content %></p>

            <!-- post.id gets replaced with actual id, when clicked browser goes to post with specific id -->
            <a href="/posts/<%= post.id %>/edit">Edit</a>
            
            <form action="/posts/<%= post.id %>/delete" method="POST">
                <button type="submit">Delete</button>
            </form>

        </article>

        <hr>

    <% }) %>

</body>

</html>